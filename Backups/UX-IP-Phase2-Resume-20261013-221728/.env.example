# Configure real values in Vercel Project Settings, never in source control.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GMAIL_USER=namaste@nyayamitrawb.in
GMAIL_APP_PASSWORD=

# Referral IP audit: set only in server/Vercel environment; never prefix with VITE_.
# Phase 2 admin IPv4 endpoint bearer token. Local development can use the mock token.
INTAKE_IP_ADMIN_TOKEN=

# Opt-in local-only intake mock. No Supabase writes or emails occur while enabled.
NYAYAMITRA_ENABLE_LOCAL_INTAKE_MOCK=false
# Optional local-only TEST-NET IPv4 (198.51.100.23) for UI review; never a production address.
NYAYAMITRA_DEV_MOCK_IPV4=false
# Client-side Vite development toggle, must remain false in production:
VITE_NYAYAMITRA_LOCAL_INTAKE_MOCK=false
