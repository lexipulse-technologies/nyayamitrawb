# Android platform — 3.4 GB, not needed for web deployment
android/

# Mobile application builds — not for web deployment
mobile application/

# APK binaries — large binary artifacts, regenerated during build
public/app/
dist/app/

# Dependencies — regenerated by npm install
node_modules/

# Build output — regenerated by npm run build
dist/

# Version control
.git/
.gitignore

# Local environment
.env
.env.*

# Backup files
*.backup-*

# macOS
.DS_Store

# IDE
.idea/
.vscode/